<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đăng Nhập - Chí Công Computer</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">
    <form action="/login" method="POST" class="bg-white p-8 rounded-xl shadow-md w-96">
        <h2 class="text-2xl font-bold mb-6 text-center text-gray-800">Đăng Nhập Nội Bộ</h2>
        <% if (error) { %>
            <div class="bg-red-100 text-red-700 p-2 rounded mb-4 text-sm"><%= error %></div>
        <% } %>
        <div class="mb-4">
            <label class="block text-sm font-semibold mb-1">Tên đăng nhập</label>
            <input type="text" name="username" class="w-full border px-3 py-2 rounded-lg" required>
        </div>
        <div class="mb-6">
            <label class="block text-sm font-semibold mb-1">Mật khẩu</label>
            <input type="password" name="password" class="w-full border px-3 py-2 rounded-lg" required>
        </div>
        <button type="submit" class="w-full bg-blue-600 text-white font-bold py-2 rounded-lg hover:bg-blue-700">Vào Hệ Thống</button>
        <div class="mt-4 text-center">
            <a href="/" class="text-sm text-blue-600 hover:underline">&larr; Về trang chủ</a>
        </div>
    </form>
</body>
</html>