<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Tra Cứu Lịch Sử - Chí Công Computer</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6">
    <div class="max-w-4xl mx-auto bg-white p-6 rounded-xl shadow">
        <div class="flex justify-between items-center mb-6 border-b pb-4">
            <h1 class="text-xl font-bold text-blue-600">🔍 Tra Cứu Lịch Sử Khách Hàng Qua SĐT</h1>
            <a href="/staff" class="text-blue-500 hover:underline">&larr; Quay lại trang Staff</a>
        </div>

        <form action="/staff/history" method="GET" class="flex gap-4 mb-6">
            <input type="text" name="phone" value="<%= phone %>" placeholder="Nhập số điện thoại khách hàng..." class="border p-2 rounded-lg flex-1" required>
            <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-blue-700">Tìm kiếm</button>
        </form>

        <% if (phone) { %>
            <h3 class="font-bold text-gray-700 mb-3">Kết quả cho SĐT: <span class="text-blue-600"><%= phone %></span></h3>
            <div class="space-y-3">
                <% if (repairs.length === 0) { %>
                    <p class="text-gray-500">Không tìm thấy lịch sử sửa chữa nào cho số điện thoại này.</p>
                <% } %>
                <% repairs.forEach(r => { %>
                    <div class="border p-4 rounded-lg bg-gray-50">
                        <p><b>Model máy:</b> <%= r.machine_name %> | <b>Khách hàng:</b> <%= r.customer_name %></p>
                        <p class="text-sm text-gray-600"><b>Tình trạng lỗi:</b> <%= r.issue_status %></p>
                        <p class="text-sm text-gray-600"><b>Chi phí thanh toán:</b> <%= Number(r.price).toLocaleString() %> VNĐ (<%= r.payment_method %>)</p>
                        <p class="text-xs text-gray-400 mt-1">Ngày tiếp nhận: <%= r.created_at %></p>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html>
